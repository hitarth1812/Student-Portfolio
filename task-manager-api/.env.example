PORT=5000

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/task-manager?retryWrites=true&w=majority

# Secret used to sign and verify JWTs - generate your own, never commit the real value
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1h

# Production only: comma-separated frontend origins allowed by CORS
# ("*" matches one subdomain label, e.g. Vercel preview URLs). Leave empty locally.
# CORS_ORIGINS=https://your-app.vercel.app,https://your-app-*.vercel.app
CORS_ORIGINS=

# In-memory cache time-to-live in seconds (node-cache)
CACHE_TTL=60

# Background job workers (Practical 10)
JOB_CONCURRENCY=2
JOB_MAX_ATTEMPTS=3

# AI Task Assistant (Practical 13) - backend only, never expose to the frontend.
# Leave GEMINI_API_KEY empty to run with the rule-based fallback only.
# (GOOGLE_API_KEY from the environment is also accepted.)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_ENABLED=true
AI_TIMEOUT_MS=10000
AI_RATE_LIMIT_PER_MIN=10
